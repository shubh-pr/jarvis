# Port the local HTTP/WebSocket server listens on
PORT=8787

# Path to the SQLite database file
DB_PATH=./jarvis.db

# Shared secret / passcode required to log into the PWA
AUTH_PASSCODE=change-me

# VAPID keys for Web Push (generate with: npx tsx src/scripts/generate-vapid.ts)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Anthropic API key used by the Claude Agent SDK
ANTHROPIC_API_KEY=

# Working directory a brand-new agent session starts in when a chat message
# arrives with no active session to route to. Defaults to JARVIS's own cwd.
AGENT_DEFAULT_CWD=

# How JARVIS addresses you in conversation.
OPERATOR_NAME=Mr. Prakash

# Shared secret Claude Code hooks use to call back into JARVIS. Generate with:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
HOOKS_SECRET=
