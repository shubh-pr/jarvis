{
  "name": "jarvis",
  "version": "0.1.0",
  "description": "Self-hosted chat/notification layer for coding agents",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "watch-project": "tsx src/scripts/watch-project.ts",
    "test:harness": "tsx test/harness.ts",
    "fire-requests": "tsx src/scripts/fire-requests.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.4",
    "@types/web-push": "^3.6.3",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  }
}
